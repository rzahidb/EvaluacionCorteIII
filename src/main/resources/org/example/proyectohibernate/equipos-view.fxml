<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectohibernate.controller.EquipoController"
      spacing="16" prefWidth="1120" prefHeight="740">
    <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Control de equipos"/>
            <Label text="Inventario del laboratorio · JavaFX + Hibernate + PostgreSQL"/>
        </VBox>
        <Button fx:id="btnRecargar" text="Recargar datos" onAction="#cargarDatos"/>
    </HBox>
    <VBox spacing="12">
        <Label fx:id="lblSeleccion" text="Nuevo equipo"/>
        <GridPane hgap="16" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Código * (máximo 10)" labelFor="$txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label text="Nombre *" labelFor="$txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Marca" labelFor="$txtMarca" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtCodigo" promptText="Ej. LAP-009" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNombre" promptText="Nombre del equipo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <TextField fx:id="txtMarca" promptText="Opcional" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <Label text="Cantidad *" labelFor="$txtCantidad" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label text="Tipo de equipo *" labelFor="$comboTipo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Estado *" labelFor="$comboEstado" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <TextField fx:id="txtCantidad" promptText="Entero mayor o igual a 0" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboTipo" promptText="Seleccione un tipo" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <ComboBox fx:id="comboEstado" promptText="Seleccione un estado" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        </GridPane>
        <HBox spacing="10">
            <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarEquipo" defaultButton="true"/>
            <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizarEquipo"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarEquipo"/>
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiarCampos"/>
        </HBox>
    </VBox>
    <HBox spacing="12" alignment="BOTTOM_LEFT">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Buscar por nombre" labelFor="$txtBuscar"/>
            <TextField fx:id="txtBuscar" promptText="Escriba parte del nombre…" onAction="#aplicarFiltros"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Filtrar por tipo" labelFor="$comboFiltroTipo"/>
            <ComboBox fx:id="comboFiltroTipo" prefWidth="230" promptText="Todos los tipos"/>
        </VBox>
        <Button fx:id="btnBuscar" text="Aplicar filtros" onAction="#aplicarFiltros"/>
        <Button fx:id="btnQuitarFiltros" text="Quitar filtros" onAction="#quitarFiltros"/>
    </HBox>
    <TableView fx:id="tablaEquipos" VBox.vgrow="ALWAYS" prefHeight="290">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="110"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="260"/>
            <TableColumn fx:id="colMarca" text="Marca" prefWidth="130"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="170"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="85"/>
            <TableColumn fx:id="colTipo" text="Tipo de equipo" prefWidth="200"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblTotal" text="Inventario sin cargar" HBox.hgrow="ALWAYS"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Seleccione una fila para editar · * Campos obligatorios"/>
    </HBox>
</VBox>
